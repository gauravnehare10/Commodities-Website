# Build-time (public). Only VITE_ variables reach the browser.
PUBLIC_SITE_URL=https://www.example.com
SITE_ENV=development            # development | staging | production
VITE_TURNSTILE_SITE_KEY=        # optional; widget hidden when empty

# Form function only (set in host dashboard; never commit real values)
TURNSTILE_SECRET_KEY=
EMAIL_PROVIDER_API_KEY=         # Resend API key (see server/submit-handler.ts)
EMAIL_FROM=                     # verified sender, e.g. website@your-domain
FORM_TO_QUOTE=                  # MI-23
FORM_TO_CONTACT=                # MI-23
CRM_WEBHOOK_URL=                # optional
